{
  "name": "bryan-murasira-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "studio"
  ],
  "scripts": {
    "predev": "node scripts/prepare-textures.mjs --dev",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:contact": "node --experimental-strip-types --test tests/contact.test.mjs",
    "verify": "node scripts/verify-build.mjs",
    "studio": "npm run dev --workspace @bryan/studio",
    "studio:build": "npm run build --workspace @bryan/studio",
    "install:ci": "npm install --no-audit --no-fund"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "@formspree/react": "3.0.0",
    "@next/env": "16.4.3",
    "@portabletext/react": "^4.0.0",
    "@react-three/fiber": "9.8.2",
    "@sanity/client": "8.11.0",
    "gsap": "3.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.3"
  }
}
